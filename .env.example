# F.U.C.K. Environment Variables
# Copy this file to .env and fill in your values

# Global salt for hashing (32 hexadecimal characters, 16 bytes)
# Generate with: python3 -c "import os; print(os.urandom(16).hex())"
FUCK_GLOBAL_SALT=0123456789abcdef0123456789abcdef

# Fernet encryption key (44 characters, base64-encoded)
# Generate with: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FUCK_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
